{
  "name": "meme-autoposter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:local": "wrangler d1 migrations apply meme-autoposter-jobs --local",
    "deploy": "node scripts/deploy.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "setup": "node scripts/admin.mjs setup",
    "status": "node scripts/admin.mjs status",
    "secrets:status": "node scripts/secret-status.mjs",
    "owner:start": "node scripts/owner.mjs start",
    "owner:status": "node scripts/owner.mjs status",
    "owner:finish": "node scripts/owner.mjs finish",
    "meta:diagnose": "node scripts/admin.mjs meta:diagnose",
    "meta:subscribe": "node scripts/admin.mjs meta:subscribe",
    "db:remote": "wrangler d1 migrations apply meme-autoposter-jobs --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "@cloudflare/vitest-plugin": "1.3.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11",
    "wrangler": "4.145.0"
  }
}
