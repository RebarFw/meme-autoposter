{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meme-autoposter",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "meme-autoposter-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meme-autoposter-jobs",
      "database_id": "1b806c2e-6ced-4845-a694-3fbf13af0b79",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "INGEST_MODE": "polling",
    "DOWNLOADER_PROVIDER": "apify",
    "META_API_VERSION": "v26.0",
    "MAX_VIDEO_BYTES": "26214400",
    "MEDIA_TTL_SECONDS": "86400",
    "ENABLE_OWNER_DM": "false",
    "ALLOW_PUBLIC_PAGE_DOWNLOADER": "true",
    "THIRD_PARTY_DOWNLOADER_PROVIDERS": "videodropper,fastdl,savefrom,snapinsta",
    "REPOST_PERMISSION_CONFIRMED": "true",
    "PUBLIC_BASE_URL": "https://meme-autoposter.meme-autoposter.workers.dev"
  }
}
