{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meme-autoposter",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "meme-autoposter-media" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "meme-autoposter-jobs",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
  "vars": {
    "META_API_VERSION": "v26.0",
    "MAX_VIDEO_BYTES": "26214400",
    "MEDIA_TTL_SECONDS": "86400",
    "ENABLE_OWNER_DM": "false",
    "ALLOW_PUBLIC_PAGE_DOWNLOADER": "true",
    "REPOST_PERMISSION_CONFIRMED": "true"
  }
}
